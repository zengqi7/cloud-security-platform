# Production settings are injected by the orchestrator or a secret manager.
# Do not commit real credentials or signing keys.
MYSQL_DSN=cloud_app:REDACTED@tcp(mysql.example:3306)/cloud_security?tls=true&parseTime=true&charset=utf8mb4&loc=UTC&timeout=5s&readTimeout=30s&writeTimeout=30s
HTTP_ADDR=0.0.0.0:8082
SCAN_DATA_DIR=/data
OPA_BIN=/usr/local/bin/opa
TRIVY_BIN=/usr/local/bin/trivy
OPA_POLICY=/app/policies/baseline.rego
DB_MAX_OPEN_CONNS=24
DB_MAX_IDLE_CONNS=8
DB_CONN_MAX_LIFETIME=5m
MYSQL_REQUIRE_TLS=true
# For private cloud CA: mount PEM read-only and set MYSQL_TLS_CA_FILE.
MYSQL_TLS_CA_FILE=
SUPPLY_CHAIN_MODE=keyless
SUPPLY_CHAIN_MAX_AGE_SECONDS=86400
TRUST_POLICY_EPOCH=production-1
TRUST_REVOKED_DIGESTS=
EVIDENCE_REQUIRE_ARCHIVE=true
# Optional read-only public key ring files <sha256>.pub for queued jobs during rotation.
COSIGN_KEYRING_DIR=
COSIGN_BIN=/usr/local/bin/cosign
COSIGN_IDENTITY=REPLACE_WITH_EXACT_IDENTITY
COSIGN_ISSUER=https://token.actions.githubusercontent.com
SLSA_BUILDER_ID=
# Optional OIDC. The issuer must be HTTPS in production.
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_AUDIENCE=cloudguard-api
# RFC 9068 access tokens; tenant/scopes come from operator-managed SQL memberships.
# Optional mounted registry catalog and per-reference Docker config Secrets.
REGISTRY_BINDINGS_FILE=/secrets/registry-bindings.json
REGISTRY_SECRET_DIR=/secrets/registries
# Optional S3-compatible evidence store.
OBJECT_STORE_ENDPOINT=https://s3.example.com
OBJECT_STORE_BUCKET=cloudguard-evidence
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_PREFIX=cloudguard/
OBJECT_STORE_SSE_KMS_KEY_ID=
