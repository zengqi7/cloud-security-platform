{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "database", "api", "worker"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
    },
    "database": {
      "type": "object",
      "properties": {"runtimeSecret": {"type": "string", "minLength": 1}}
    },
    "api": {"type": "object", "properties": {"replicas": {"type": "integer", "minimum": 2}}},
    "worker": {"type": "object", "properties": {"replicas": {"type": "integer", "minimum": 2}}},
    "env": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$", "not": {"enum": ["MYSQL_DSN", "HTTP_ADDR", "WORKER_HTTP_ADDR"]}},
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "migration": {
      "type": "object",
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,15}$"}}
    }
  }
}
