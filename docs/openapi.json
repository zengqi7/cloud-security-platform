{
  "openapi": "3.1.0",
  "info": {
    "description": "Database Bearer keys require scans:read for GET, scans:submit for submission, and reports:import for imported reports. Invalid keys return 401; missing scope 403; auth/audit outage 503. Clean unverified imported reports never pass the release gate.",
    "title": "Cloud Security Platform",
    "version": "0.1.0",
    "x-contract": "See docs/contracts.md for compatibility and delivery guarantees."
  },
  "paths": {
    "/api/v1/rescans":{"post":{"description":"Create durable rescan from successful pinned image/manifest scan; rescans:write + scans:submit. Interval 3600..2592000 seconds. Creates a new schedule on each call.","security":[{"bearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["scan_id","interval_seconds"],"properties":{"scan_id":{"type":"string"},"interval_seconds":{"type":"integer","minimum":3600,"maximum":2592000}}}}}},"responses":{"201":{"description":"Schedule identity and next run"},"403":{"description":"Scope missing"},"409":{"description":"Source scan not succeeded"}}}},
    "/api/v1/rescans/{id}":{"get":{"description":"Tenant schedule with scans:read.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Schedule"},"404":{"description":"Not found"}}}},
    "/api/v1/rescans/{id}/disable":{"post":{"description":"Disable schedule with reason and rescans:write; auditable and safe to repeat.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Disabled"},"404":{"description":"Not found"}}}},
    "/api/v1/scans/{id}/diff": {"get":{"description":"Same-tenant risk delta. Comparable only for ordered, successful, complete scans of same asset/series/policy/scope/scanner version. possibly_fixed is not confirmed remediation.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"base","in":"query","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Comparability, reason, new/retained/resolved/possibly_fixed"},"404":{"description":"Not found"}}}},
    "/api/v1/scans/{id}/sbom": {"get":{"description":"Canonical CycloneDX JSON with verified stored SHA-256, scans:read.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"SBOM"},"404":{"description":"Not found or unavailable"},"503":{"description":"Storage/integrity error"}}}},
    "/api/v1/waivers": {"post":{"description":"Request exact scan/fingerprint TTL waiver; waivers:request required.","security":[{"bearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["scan_id","fingerprint","reason","expires_at"]}}}},"responses":{"201":{"description":"Pending waiver"},"400":{"description":"Invalid TTL/reason"},"409":{"description":"Scan/severity not eligible"}}}},
    "/api/v1/waivers/{id}": {"get":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Same-tenant waiver"},"404":{"description":"Not found"}}}},
    "/api/v1/waivers/{id}/decision": {"post":{"description":"Approve/reject/revoke with reason; waivers:approve; no self approval.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Audited decision"},"403":{"description":"Insufficient scope/self approval"},"409":{"description":"Expired or incompatible state"}}}},
    "/api/v1/scans/{id}/assessments": {"post":{"description":"Immutable point-in-time assessment, assessments:write; required Idempotency-Key.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","maxLength":128}}],"security":[{"bearer":[]}],"responses":{"201":{"description":"Original/effective gate and validity deadline"},"409":{"description":"Unfinished scan or key conflict"}}}},
    "/api/v1/assessments/{id}": {"get":{"description":"Historical evidence, not perpetual approval; scans:read.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Immutable assessment JSON"},"404":{"description":"Not found"}}}},
    "/api/v1/policies": {"post":{"description":"Publish full immutable bundle after real OPA tests; policies:publish required.","security":[{"bearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["version","rego","block_severities","tests"]}}}},"responses":{"201":{"description":"Version and SHA-256 digest"},"400":{"description":"Invalid or failed policy tests"},"403":{"description":"Missing scope"},"503":{"description":"Storage or tool unavailable"}}}},
    "/api/v1/policies/{digest}": {"get":{"description":"Read tenant bundle with scans:read.","parameters":[{"name":"digest","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{64}$"}}],"security":[{"bearer":[]}],"responses":{"200":{"description":"Full pinned policy bundle"},"404":{"description":"Not found"}}}},
    "/api/v1/scans/{id}/sarif": {
      "get": {
        "description": "SARIF 2.1.0 all findings; logical locations without fabricated source lines. Requires scans:read.",
        "parameters": [{"name":"id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$"}}],
        "security": [{"bearer":[]}],
        "responses": {"200":{"description":"SARIF JSON"},"409":{"description":"Scan unfinished"},"404":{"description":"Not found"},"503":{"description":"Storage unavailable"}}
      }
    },
